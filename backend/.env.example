# ── Copy to .env and fill in your values ──────────────────────────────────────
# Never commit .env or real keys. Use your host's "Environment variables" UI in production.

# Database (managed hosts often inject DATABASE_URL for you)
DATABASE_URL=postgresql://user:password@host:5432/nobel

# Auth — production: long random secret (32+ chars). Example generator:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-real-secret-key-at-least-32-chars

# CORS — exact frontend origin(s), comma-separated, HTTPS in production (not *)
ALLOWED_ORIGINS=https://your-frontend.netlify.app

# production enables stricter checks (CORS + SECRET_KEY); use development locally
ENVIRONMENT=production

# LLM — keep keys only here / on the server. Do not put provider keys in the frontend or NEXT_PUBLIC_*.
OPENAI_API_KEY=test
LLM_BASE_URL=https://vjioo4r1vyvcozuj.us-east-2.aws.endpoints.huggingface.cloud/v1
LLM_MODEL=openai/gpt-oss-120b
