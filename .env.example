# This repo’s API is the FastAPI app in /backend.
# Use that file as the real template:
#
#   backend/.env.example  →  copy to backend/.env for local API runs
#
# Frontend (Next.js): optional local file frontend/.env.local with only:
#   NEXT_PUBLIC_API_URL=http://localhost:8000
#
# Production: set variables in your host’s dashboard (Netlify = frontend only;
# Render/Railway/etc. = backend). Do not rely on this root file.
